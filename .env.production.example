# ---------------------------------------------------------------------------
# Platinum Casino - production environment template.
#
# 1. Copy this file:        cp .env.production.example .env.production
# 2. Fill in every secret  (anything ending in =).
# 3. Bring the stack up:    docker compose -f docker-compose.prod.yml \
#                             --env-file .env.production up -d --build
#
# DO NOT commit .env.production. It is excluded by .gitignore.
# ---------------------------------------------------------------------------

# ---- Public-facing config -------------------------------------------------
# DNS-resolvable hostname; Caddy will request an LE certificate for both
# DOMAIN and www.DOMAIN automatically.
DOMAIN=
# Operator email for the Let's Encrypt account (expiry warnings land here).
ADMIN_EMAIL=

# ---- Database -------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=platinum_casino
MYSQL_USER=casino_user
MYSQL_PASSWORD=

# Server reaches MySQL on the docker network as host "db".
DATABASE_URL=mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@db:3306/${MYSQL_DATABASE}

# ---- Auth -----------------------------------------------------------------
# 32+ char random string. Generate with:  openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://${DOMAIN}

# CORS origin used by the server. Comma-separated values are supported.
CLIENT_URL=https://${DOMAIN}

# ---- Runtime --------------------------------------------------------------
NODE_ENV=production

# ---- Client build-time --------------------------------------------------
# Anything prefixed VITE_ is baked into the SPA at build time.
VITE_CURRENCY_NAME=Credits
